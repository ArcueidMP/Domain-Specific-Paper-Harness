# Preserve the human-readable release tag and pin the independently verified
# multi-platform Docker Hub manifest. Production additionally pins the mirrored
# wrapper image through the `grobid_image` Terraform input.
FROM grobid/grobid:0.9.0-crf@sha256:24ba90eb1c959f65d812bcdb2cf79c677fa5fd7b95235de616b8bc9fa1317849

LABEL org.opencontainers.image.title="Domain-Specific Paper Harness GROBID runtime" \
      org.opencontainers.image.description="Unmodified GROBID 0.9.0 CRF runtime with Paper Harness provenance" \
      org.opencontainers.image.source="https://github.com/grobidOrg/grobid" \
      org.opencontainers.image.version="0.9.0-crf" \
      org.opencontainers.image.licenses="Apache-2.0" \
      io.paper-harness.upstream-image="grobid/grobid:0.9.0-crf@sha256:24ba90eb1c959f65d812bcdb2cf79c677fa5fd7b95235de616b8bc9fa1317849" \
      io.paper-harness.upstream-source-copied="false"

EXPOSE 8070

STOPSIGNAL SIGTERM
