# syntax=docker/dockerfile:1.7

FROM node:24.15.0-bookworm-slim AS web-build
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@11.0.9 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile
COPY apps/web apps/web
RUN pnpm build

FROM ghcr.io/astral-sh/uv:0.12.3 AS uv

FROM python:3.13.13-slim-bookworm AS python-build
COPY --from=uv /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project
COPY src src
COPY apps/api apps/api
COPY configs configs
COPY migrations migrations
COPY alembic.ini ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

FROM python:3.13.13-slim-bookworm AS runtime
ENV PATH=/app/.venv/bin:$PATH \
    PYTHONPATH=/app/apps/api \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PAPER_HARNESS_STATIC_DIR=/app/static
WORKDIR /app
RUN groupadd --system --gid 10001 paper-harness \
    && useradd --system --uid 10001 --gid paper-harness --home-dir /nonexistent --shell /usr/sbin/nologin paper-harness
COPY --from=python-build --chown=paper-harness:paper-harness /app /app
COPY --from=web-build --chown=paper-harness:paper-harness /workspace/apps/web/dist /app/static
USER 10001:10001
EXPOSE 8080
CMD ["uvicorn", "paper_harness_api.main:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
