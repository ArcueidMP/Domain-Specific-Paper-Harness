      <div xml:id="sec-introduction">
        <head coords="1,72.0,90.0,160.0,12.0">Introduction</head>
        <p xml:id="p-introduction" coords="1,72.0,115.0,468.0,36.0">
          <s xml:id="s-introduction-1" coords="1,72.0,115.0,468.0,12.0">LLM agents use tools <ref type="bibr" target="#b0" coords="1,201.0,115.0,16.0,12.0">[1]</ref> to solve tasks.</s>
          <s xml:id="s-introduction-2">Memory improves long-horizon execution.</s>
        </p>
      </div>
      <div xml:id="sec-evaluation">
        <head coords="2,72.0,90.0,140.0,12.0">Evaluation</head>
        <p xml:id="p-evaluation" coords="2,72.0,115.0,468.0,24.0">We evaluate on AgentBench <ref type="bibr" target="#b1" coords="2,247.0,115.0,18.0,12.0">[2]</ref> with exact-match accuracy.</p>
      </div>
