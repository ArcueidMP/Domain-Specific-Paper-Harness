project_id  = "your-existing-project-id"
owner_email = "owner@example.com"

# Infrastructure-only is the safe default. Each runtime boundary is enabled only
# after its immutable image and required fixed numeric secret versions exist.
deploy_migration_resources = false
deploy_runtime_resources = false
deploy_analysis_resources = false
deploy_daily_resources = false
deploy_scheduler = false
scheduler_paused = true

# migration_image = "asia-southeast1-docker.pkg.dev/PROJECT/REPOSITORY/web-api@sha256:..."
# migration_database_secret_version = "1"

# Migrations are deployed and executed before the Web/API service or Daily Job.
# deploy_migration_resources = true

# Web/API and its IAP boundary can be deployed without the Daily Job.
# deploy_runtime_resources = true
# web_api_image = "asia-southeast1-docker.pkg.dev/PROJECT/REPOSITORY/web-api@sha256:..."
# database_secret_version = "1"

# GROBID is independently deployable and does not require Web/API, Daily, or
# DeepSeek. It has no public invoker; only the dedicated Daily identity
# receives its authoritative invoker binding for private verification and use.
# The upstream GROBID 0.9.0-crf manifest is pinned in Dockerfile.grobid. Before
# enabling it, build the first-party service image and use its immutable digest.
# deploy_analysis_resources = true
# grobid_image = "asia-southeast1-docker.pkg.dev/PROJECT/REPOSITORY/grobid@sha256:..."

# The complete Daily Job requires GROBID plus fixed database, DeepSeek, and
# Semantic Scholar secret versions. It can be deployed independently of Web/API.
# Keep it disabled while either required API key version is unavailable. SPECTER2
# Base is baked into the production Daily image and does not use either API key.
# deploy_daily_resources = true
# daily_image = "asia-southeast1-docker.pkg.dev/PROJECT/REPOSITORY/daily@sha256:..."
# database_secret_version = "1"
# deepseek_secret_version = "1"
# semantic_scholar_secret_version = "1"

# Create Scheduler paused only after a successful manual Daily execution.
# deploy_scheduler = true
# scheduler_paused = true
