# syntax=docker/dockerfile:1.7

FROM node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d AS web-build
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@11.0.9 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY scripts/export_frontend_licenses.mjs scripts/export_frontend_licenses.mjs
RUN pnpm install --frozen-lockfile
RUN node scripts/export_frontend_licenses.mjs --output /workspace/frontend-license-material
COPY apps/web apps/web
RUN pnpm build

FROM ghcr.io/astral-sh/uv:0.12.3@sha256:2d890623d310b57771ce840f0da5eed5fc6d657da05ffaa45d82797b53fa3abc AS uv

FROM python:3.13.13-slim-bookworm@sha256:355bfa66770995d7e9a0da4b3473b44d0cb451f6b56f5615ad9c39e3c4eca03f AS python-build
COPY --from=uv /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY README.md ./
COPY LICENSE ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project
COPY src src
COPY apps/api apps/api
COPY configs configs
COPY migrations migrations
COPY alembic.ini ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

FROM python:3.13.13-slim-bookworm@sha256:355bfa66770995d7e9a0da4b3473b44d0cb451f6b56f5615ad9c39e3c4eca03f AS runtime
LABEL org.opencontainers.image.title="Domain-Specific Paper Harness Web/API" \
      org.opencontainers.image.description="Private FastAPI and React research-intelligence service" \
      org.opencontainers.image.source="https://github.com/ArcueidMP/Domain-Specific-Paper-Harness" \
      org.opencontainers.image.version="0.1.0" \
      org.opencontainers.image.licenses="Apache-2.0"
ENV APP_ENV=production \
    PATH=/app/.venv/bin:$PATH \
    PYTHONPATH=/app/apps/api \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PAPER_HARNESS_STATIC_DIR=/app/static
WORKDIR /app
RUN groupadd --system --gid 10001 paper-harness \
    && useradd --system --uid 10001 --gid paper-harness --home-dir /nonexistent --shell /usr/sbin/nologin paper-harness
COPY --from=python-build --chown=paper-harness:paper-harness /app /app
COPY --from=web-build --chown=paper-harness:paper-harness /workspace/apps/web/dist /app/static
COPY --from=web-build --chown=paper-harness:paper-harness /workspace/frontend-license-material /opt/licenses/frontend
COPY --chown=paper-harness:paper-harness LICENSE /opt/licenses/paper-harness/LICENSE
COPY --chown=paper-harness:paper-harness THIRD_PARTY_NOTICES.md /opt/licenses/paper-harness/THIRD_PARTY_NOTICES.md
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["python", "-c", "import urllib.request; response = urllib.request.urlopen('http://127.0.0.1:8080/health/live', timeout=3); status = response.status; response.close(); raise SystemExit(status != 200)"]
STOPSIGNAL SIGTERM
CMD ["uvicorn", "paper_harness_api.main:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
