# Local PostgreSQL. Use a secret-backed DATABASE_URL in deployed runtimes.
POSTGRES_DB=paper_harness
POSTGRES_USER=paper_harness
POSTGRES_PASSWORD=paper_harness_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://paper_harness:paper_harness_local@localhost:5432/paper_harness

# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
PAPER_HARNESS_STATIC_DIR=
TOPIC_CONFIG_PATH=configs/topics/broad-llm-agents.yaml

# M2 analysis dependencies. Empty values are not replaced by mocks or fallback providers.
ANALYSIS_MODE=full_text
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
GROBID_URL=
GROBID_AUDIENCE=
GROBID_AUTH_MODE=none
GROBID_PORT=8070

# M3 scholarly search. Only historical-backfill and search-related consume this
# value; the read API and arXiv ingestion stay keyless.
SEMANTIC_SCHOLAR_API_KEY=
